# Copy to .env and fill in the keys you have. Never commit .env.

# --- Provider credentials (any subset works; AuraGen falls back in order) ---
FAL_KEY=key_id:key_secret
REPLICATE_API_TOKEN=r8_...
HF_TOKEN=hf_...

# --- Optional overrides -----------------------------------------------------
# Pin every task to one engine (fal | replicate | huggingface | comfyui):
# AURAGEN_ENGINE=fal
# Custom fallback order:
# AURAGEN_ENGINE_ORDER=fal,replicate,huggingface,comfyui
# Local ComfyUI server:
# AURAGEN_COMFY_URL=http://127.0.0.1:8188
# Your own exported ComfyUI API-format workflow with %%PROMPT%% placeholders:
# AURAGEN_COMFY_WORKFLOW=/path/to/workflow_api.json
# Output root and default brand preset:
# AURAGEN_OUTPUT_DIR=outputs
# AURAGEN_DEFAULT_STYLE=photorealistic
# AURAGEN_BRAND_FILE=/path/to/brand.json
